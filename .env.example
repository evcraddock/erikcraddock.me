# App
PORT=5000
NODE_ENV=development  # development | test | production
LOG_LEVEL=debug       # debug | info | warn | error

# Domain (for ActivityPub)
DOMAIN=erikcraddock.me

# Admin (for seeding and auth)
ADMIN_EMAIL=admin@example.com

# SQLite
DATABASE_PATH=./data/erikcraddock.db

# S3/Object Storage (Garage in dev)
# Run `./scripts/setup-garage.sh` after starting docker to get keys
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY=<from setup-garage.sh output>
S3_SECRET_KEY=<from setup-garage.sh output>
S3_BUCKET=erikcraddock-media
S3_REGION=garage

# SMTP (optional in dev - magic links are logged to console)
# Uncomment to use Mailpit: Web UI at http://localhost:8025
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
FROM_EMAIL=noreply@erikcraddock.me

# Garage admin API token (must match garage.toml)
GARAGE_ADMIN_TOKEN=dev-admin-token

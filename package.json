{
  "name": "erikcraddock.me",
  "version": "1.12.0",
  "description": "Personal website and blog that also acts as an activitypub actor",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.tsx",
    "build": "npm run css:build && npm run build:bundle",
    "build:bundle": "esbuild src/index.tsx --bundle --platform=node --target=node22 --outfile=dist/index.cjs --format=cjs --packages=external",
    "start": "node dist/index.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "css:build": "npx @tailwindcss/cli -i ./src/styles/main.css -o ./public/css/main.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ./src/styles/main.css -o ./public/css/main.css --watch",
    "prepare": "husky"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@aws-sdk/client-s3": "^3.975.0",
    "@fedify/fedify": "^1.10.2",
    "@fedify/hono": "^1.10.2",
    "@fedify/sqlite": "^1.10.2",
    "@hono/node-server": "^1.19.9",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "@simplewebauthn/browser": "^13.2.2",
    "@simplewebauthn/server": "^13.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.0.0",
    "marked": "^17.0.1",
    "nodemailer": "^7.0.13",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.6",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^7.0.9",
    "canvas": "^3.2.1",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.27.2",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.18",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}

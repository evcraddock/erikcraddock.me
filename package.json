{
  "name": "erikcraddock.me",
  "version": "0.1.0",
  "description": "Personal website and blog that also acts as an activitypub actor",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.tsx",
    "build": "npm run css:build && tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "css:build": "npx @tailwindcss/cli -i ./src/styles/main.css -o ./public/css/main.css --minify",
    "css:watch": "npx @tailwindcss/cli -i ./src/styles/main.css -o ./public/css/main.css --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@hono/node-server": "^1.19.9",
    "@tailwindcss/typography": "^0.5.19",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.0.0",
    "marked": "^17.0.1",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/cli": "^4.1.18",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.6",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^7.0.9",
    "@vitest/coverage-v8": "^1.0.0",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.0.0"
  }
}
